<Page
    x:Class="WinUIGallery.ControlPages.CompositionXamlInteropPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel>
        <controls:ControlExample
            CSharpSource="Composition/CompositionXamlInteropSample_cs.txt"
            HeaderText="Use XAML and Composition visuals together"
            Loaded="XamlInteropExample_Loaded"
            Unloaded="XamlInteropExample_Unloaded"
            XamlSource="Composition/CompositionXamlInteropSample_xaml.txt">
            <StackPanel Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="Animate XAML content with GetElementVisual" />
                    <Border Padding="0,4">
                        <TextBlock
                            x:Name="AnimatedTextBlock"
                            Text="This TextBlock is a XAML element animated by Microsoft.UI.Composition."
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="Insert Composition content with SetElementChildVisual" />
                    <Grid
                        x:Name="SpriteHost"
                        Height="150"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock
                            Margin="12"
                            Text="The red and blue squares are SpriteVisual children hosted under this Grid."
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="Change Composition tree order at runtime" />
                    <Grid
                        x:Name="OrderHost"
                        Height="150"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock
                            Margin="12"
                            Text="The overlapping squares rotate their z-order once per second."
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
