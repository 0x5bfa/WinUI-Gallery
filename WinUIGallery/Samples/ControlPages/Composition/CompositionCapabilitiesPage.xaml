<Page
    x:Class="WinUIGallery.ControlPages.CompositionCapabilitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel>
        <controls:ControlExample
            CSharpSource="Composition/CompositionCapabilitiesSample_cs.txt"
            HeaderText="React to Composition effect capabilities"
            Loaded="CapabilitiesExample_Loaded"
            Unloaded="CapabilitiesExample_Unloaded"
            XamlSource="Composition/CompositionCapabilitiesSample_xaml.txt">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="320" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="16">
                    <ToggleSwitch
                        x:Name="CapabilityToggle"
                        AutomationProperties.Name="Simulate composition capabilities"
                        IsOn="True"
                        OffContent="Use live capabilities"
                        OnContent="Simulate capabilities"
                        Toggled="CapabilityToggle_Toggled" />
                    <ComboBox
                        x:Name="SimulatorDropdown"
                        Width="220"
                        Header="Capability"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind CapabilityDropdownOptions}"
                        SelectionChanged="SimulatorDropdown_SelectionChanged" />
                </StackPanel>

                <Grid
                    x:Name="ImageCanvas"
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    SizeChanged="ImageCanvas_SizeChanged" />

                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{x:Bind CapabilityText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>
        </controls:ControlExample>
    </StackPanel>
</Page>
