<Page
    x:Class="WinUIGallery.ControlPages.SceneNodePlaygroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel>
        <controls:ControlExample
            CSharpSource="Composition/SceneNodePlaygroundSample_cs.txt"
            HeaderText="Render a SceneNode mesh with Composition"
            Loaded="SceneNodeExample_Loaded"
            Unloaded="SceneNodeExample_Unloaded"
            XamlSource="Composition/SceneNodePlaygroundSample_xaml.txt">
            <Grid
                x:Name="SceneHost"
                Height="420"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                SizeChanged="SceneHost_SizeChanged">
                <TextBlock
                    Margin="12"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="A simple SceneMesh is rendered with Microsoft.UI.Composition.Scenes and rotated by a Composition animation."
                    TextWrapping="Wrap" />
            </Grid>
        </controls:ControlExample>
    </StackPanel>
</Page>
